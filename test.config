server
	host 127.0.0.1
	port 3001
	error_page 400 .pageHTLM/error_pages/400.html
	error_page 404 .pageHTLM/error_pages/404.html
	error_page 500 .pageHTLM/error_pages/500.html
	client_max_body_size 1073741824
	location /
		allow GET
		alias .pageHTLM 
		index index.html
		autoindex off
	
	location /cgi-bin/
		allow POST GET
		root .pageHTLM
		cgi_handler .php /usr/bin/php
		cgi_handler .py /usr/bin/python3
		cgi_handler .sh /usr/bin/bash
	
	location /testupload
		root .pageHTLM
		allow DELETE GET
