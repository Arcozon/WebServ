server
	host 127.0.0.1
	port 3001
	error_page 400 .pageHTLM/error_pages/400.html
	error_page 404 .pageHTLM/error_pages/404.html
	error_page 500 .pageHTLM/error_pages/500.html
	client_max_body_size 1073741824

	location /
		allow GET
		alias ./.pageHTLM
		autoindex on
		index index.plop index.html index.flute
	location /noGet
		allow POST
	location /testing
		allow GET
		return 403

	location /redir403
		allow GET
		return 403

	location /redir403/
		allow GET
		return 405 erreur a l aide !

	location /test/slt
		allow GET
		return 404 index.html

	location /site
		allow GET POST DELETE
		autoindex off
		index index.html
		alias ./.pageHTLM/site

	location /uploads
		allow POST GET
		autoindex on
		upload_store ./.pageHTLM/upload

	location /cgi-bin//.//
		allow POST GET
		root ./cgi-bin/
		cgi_handler .py /usr/bin/python
		cgi_handler .php /usr/bin/php

	location /site/login
		allow POST GET DELETE
		index login.html
		root ./.pageHTLM/site

	location /site/protected
		return 302 /site/login
		allow POST GET
	return 302 /testconfig
server
	host 127.0.0.1
	port 8080
	error_page 400 .pageHTLM/error_pages/400.html
	error_page 404 .pageHTLM/error_pages/404.html
	error_page 500 .pageHTLM/error_pages/500.html
	client_max_body_size 1073741824
	location /new
		return 302 http://127.0.0.1:3001
	return 302 new
